{
  "kinds": {
    "cloudwatch.alarm": {
      "ack": "none",
      "channels": [
        "email"
      ],
      "class": "operator",
      "defaultOn": true,
      "grouping": {
        "by": [
          "product",
          "site"
        ],
        "windowSeconds": 120
      },
      "lifecycle": "incident"
    }
  }
}
